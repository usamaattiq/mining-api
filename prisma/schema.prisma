generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DevicePlatform {
  ios
  android
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  MPIN_RESET
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AccountType {
  INDIVIDUAL
  COMPANY
}

model User {
  id                 String      @id @default(uuid())
  fullName           String
  phoneE164          String      @unique
  countryCode        String
  countryCallingCode String
  email              String?     @unique
  address            String?
  latitude           Float?
  longitude          Float?
  avatarUrl          String?
  accountType        AccountType @default(INDIVIDUAL)
  companyName        String?
  biometricEnabled   Boolean     @default(false)
  status             UserStatus  @default(ACTIVE)
  isVerified         Boolean     @default(false)
  /** RMS / RFQ user id — set when the mining account is linked to RFQ. */
  rmsId              String?     @unique
  lastLoginAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  credential      UserCredential?
  sessions        UserSession[]
  listings        Listing[]
  buyerChats      Conversation[]          @relation("ConversationBuyer")
  sellerChats     Conversation[]          @relation("ConversationSeller")
  sentMessages    Message[]
  readReceipts    ConversationReadReceipt[]
  inboxItems      InAppNotification[]

  @@map("users")
}

model UserCredential {
  id             String    @id @default(uuid())
  userId         String    @unique
  mpinHash       String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model UserSession {
  id        String    @id @default(uuid())
  userId    String
  deviceId  String
  jti       String    @unique
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceId])
  @@map("user_sessions")
}

model OtpChallenge {
  id         String     @id @default(uuid())
  phoneE164  String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phoneE164, purpose, createdAt])
  @@map("otp_challenges")
}

// One row per (user, device). Holds the Expo push token Ping needs to
// deliver notifications; mirrors the device shape Ping's /devices API expects.
model PushDevice {
  id              String         @id @default(uuid())
  userId          String
  platform        DevicePlatform
  expoPushToken   String         @unique
  pingDeviceId    String?        @unique // id returned by Ping after registration
  isActive        Boolean        @default(true)
  lastRegisteredAt DateTime      @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@map("push_devices")
}

enum ListingCategory {
  equipment
  services
  gold
}

enum ListingStatus {
  ACTIVE
  ARCHIVED
}

enum EquipmentMode {
  rent
  sell
}

enum ServiceListingType {
  onsite
  online
}

enum DeliveryType {
  free
  perKm
}

enum MediaKind {
  photo
  video
  document
}

enum NotificationTarget {
  Requests
  Messages
  HomeTab
}

enum MarketplaceRole {
  buyer
  supplier
}

model Listing {
  id        String          @id @default(uuid())
  ownerId   String
  category  ListingCategory
  status    ListingStatus   @default(ACTIVE)
  postedAs  MarketplaceRole @default(supplier)
  title     String
  description String        @default("")
  location  String          @default("")

  equipmentMode        EquipmentMode?
  equipmentTypeLabel   String?
  hourlyRental         String?
  monthlyRental        String?
  weeklyRental         String?
  salePrice            String?
  units                Int?
  deliveryAvailable    Boolean?
  deliveryType         DeliveryType?
  deliveryPricePerKm   String?

  serviceType            ServiceListingType?
  serviceCategoryLabel   String?
  yearsOfExperience      String?
  price                  String?
  serviceDate            DateTime?

  weight         String?
  purityLabel    String?
  auctionEndDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  media          ListingMedia[]
  conversations  Conversation[]

  @@index([ownerId, category, createdAt])
  @@index([postedAs, category, createdAt])
  @@map("listings")
}

model ListingMedia {
  id        String    @id @default(uuid())
  listingId String
  uri       String
  kind      MediaKind
  name      String?
  key       String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("listing_media")
}

model Conversation {
  id        String   @id @default(uuid())
  listingId String
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing  Listing                  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User                     @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User                     @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]
  receipts ConversationReadReceipt[]

  @@unique([listingId, buyerId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  text           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model ConversationReadReceipt {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_read_receipts")
}

model InAppNotification {
  id        String             @id @default(uuid())
  userId    String
  titleKey  String
  bodyKey   String
  sentAt    DateTime           @default(now())
  read      Boolean            @default(false)
  icon      String
  target    NotificationTarget
  listingId String?
  conversationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@map("in_app_notifications")
}
