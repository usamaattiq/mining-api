NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mining?schema=public
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
OTP_EXPIRES_MINUTES=5
OTP_REAL_ENABLED=false
MPIN_LOCKOUT_ATTEMPTS=5
MPIN_LOCKOUT_MINUTES=15
OTP_RATE_LIMIT_EXEMPT_PHONES=

# WhatsApp Configuration
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v22.0
WHATSAPP_API_TIMEOUT=30000

# AWS Configuration (S3)
AWS_REGION=eu-north-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bucket must allow public s3:GetObject (see bucket policy in deploy notes).
AWS_S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRES_IN=300

# Push notifications (via Ping — centralized notification service)
# Prefer base URL ending with /api/v1 (e.g. http://localhost:3000/api/v1)
PING_BASE_URL=
PING_API_KEY=
PING_API_TIMEOUT=30000

# RFQ integration (RMS at http://localhost:8091)
RFQ_BASE_URL=http://localhost:8091
RFQ_API_KEY=rms_mining_local_dev_key
RFQ_API_TIMEOUT=30000

# Auction integration (gold listings). Local AMS default port is 8090.
AUCTION_BASE_URL=http://localhost:8090
AUCTION_API_KEY=
AUCTION_API_TIMEOUT=30000

# SmartBackload integration
SMARTBACKLOAD_BASE_URL=
SMARTBACKLOAD_API_KEY=
SMARTBACKLOAD_API_TIMEOUT=30000

# Google Cloud Pub/Sub — consume RMS topic rfq-events
# Subscription filter: attributes.platform_id = "mining"
# Later: set PUBSUB_ENABLED=true and fill PROJECT_ID + credentials only.
PUBSUB_ENABLED=false
PUBSUB_PROJECT_ID=
PUBSUB_TOPIC_ID=rfq-events
PUBSUB_SUBSCRIPTION_ID=mining-api-rfq-events
RMS_PLATFORM_ID=mining
# Path to service-account JSON (prod). Leave empty for ADC / emulator.
GOOGLE_APPLICATION_CREDENTIALS=
# Local emulator only, e.g. localhost:8086. Leave empty in production.
PUBSUB_EMULATOR_HOST=
