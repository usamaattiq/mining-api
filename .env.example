NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mining?schema=public
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=30d
OTP_EXPIRES_MINUTES=5
OTP_REAL_ENABLED=false
MPIN_LOCKOUT_ATTEMPTS=5
MPIN_LOCKOUT_MINUTES=15

# WhatsApp Configuration
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v22.0
WHATSAPP_API_TIMEOUT=30000

# AWS Configuration (S3)
AWS_REGION=eu-north-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bucket must allow public s3:GetObject (see bucket policy in deploy notes).
AWS_S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRES_IN=300

# Push notifications (via Ping - centralized notification service)
PING_BASE_URL=
PING_API_KEY=
PING_API_TIMEOUT=30000

# RFQ integration
RFQ_BASE_URL=
RFQ_API_KEY=
RFQ_API_TIMEOUT=30000

# Auction integration
AUCTION_BASE_URL=
AUCTION_API_KEY=
AUCTION_API_TIMEOUT=30000

# SmartBackload integration
SMARTBACKLOAD_BASE_URL=
SMARTBACKLOAD_API_KEY=
SMARTBACKLOAD_API_TIMEOUT=30000

# Google Cloud Pub/Sub
PUBSUB_ENABLED=false
PUBSUB_PROJECT_ID=
PUBSUB_SUBSCRIPTION_ID=
